{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/app-prevencope/browser" }
    }
  ],
  "routes": [
    { "src": "/api/health", "dest": "/api/health.js" },
    { "handle": "filesystem" },
    { "src": "(.*)", "dest": "/index.csr.html" }
  ]
}
